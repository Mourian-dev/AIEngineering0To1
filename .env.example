# .env.example — copy to .env and fill in real values.
# .env itself must never be committed — see .gitignore.

# Optional. Defaults to http://localhost:11434 if omitted.
OLLAMA_BASE_URL=http://localhost:11434

# Required only if you run ask.py with --provider openai
OPENAI_API_KEY=sk-your-real-key-here

# Required only if you run ask.py with --provider anthropic
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Required only if you run aks.py with --provider nvidia
NVIDIA_API_KEY="nvapi-nvid-your-real-key-here"